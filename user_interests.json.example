{
  "_说明": [
    "【这个文件是什么】news-aggregator 的用户兴趣配置文件：动态搜索主题、默认日报源、内容过滤规则等全部人态偏好都在这里。",
    "程序在 skill 根目录读取本文件（路径见 push_to_obsidian.py 的 USER_CONFIG_PATH）。"
  ],
  "_使用说明": [
    "【怎么用】复制本文件为 user_interests.json 后按需修改：cp user_interests.json.example user_interests.json。",
    "user_interests.json 已被 .gitignore 忽略（不会提交你的个人兴趣）；",
    "以 _ 开头的键是注释，程序读取时会忽略。"
  ],
  "_缺省总说明": [
    "【不填会怎样】本文件缺失或某键缺失都不会报错：load_user_config 缺文件返回空 dict，程序自动退化（详见各键说明）。",
    "建议至少配置 topics 与 daily_sources，否则动态搜索和定时日报会用内置默认或直接退化。"
  ],
  "topics": [
    "大模型最新动态",
    "AI Agent 框架与多智能体协作",
    "LLM 前沿与模型推理优化"
  ],
  "_topics说明": [
    "【topics】动态搜索的主题列表，必填。",
    "作用：① 定时任务跑全网动态搜索（fetch_dynamic_search.py）时按这些主题搜；",
    "② bilibili 的搜索关键词也复用这里的值（经 NEWS_AGGREGATOR_TOPICS 环境变量透传）。",
    "修改方式：增删字符串即可，每个元素一个主题。",
    "不填会怎样：动态搜索无主题可搜，直接返回空结果；bilibili 关键词为空。"
  ],
  "reject": [
    "文档导航/目录",
    "职业指南",
    "官网首页信息流",
    "硬件装机",
    "游戏/生活"
  ],
  "_reject说明": [
    "【reject】主题拒绝词列表，可选。",
    "作用：这些词会注入 AI 候选准入与最终推荐 prompt，AI 判断时遇到相关内容会倾向拒绝。",
    "修改方式：增删字符串；留空数组 [] 表示不过滤。",
    "不填会怎样：不注入拒绝词，AI 只按 topics 判断相关性，可能收进你不想看的内容。"
  ],
  "daily_sources": [
    "juejin",
    "devto",
    "github",
    "openai",
    "bilibili"
  ],
  "_daily_sources说明": [
    "【daily_sources】定时任务的默认日报来源（source key 列表），必填。",
    "作用：run_daily.py 执行时用这些源生成每日 Obsidian 日报，每源 15 条上限。",
    "source key 对照 SKILL.md 源表（如 juejin=掘金热榜、devto=Dev.to、github=GitHub Trending）。",
    "修改方式：增删 source key；命令行 --source 可临时覆盖，不修改本文件。",
    "不填会怎样：run_daily 退化为推送全部 53 个源（很慢且杂），建议始终配置。"
  ],
  "limit_per_topic": 5,
  "_limit_per_topic说明": [
    "【limit_per_topic】动态搜索时每个主题最多取多少条，可选（默认 3）。",
    "修改方式：改数字；命令行 --dynamic-limit 显式传参会优先于这里的值。",
    "不填会怎样：使用内置默认 3（fetch_dynamic_search 与 push_to_obsidian 的兜底值）。"
  ],
  "limit_per_source": 15,
  "_limit_per_source说明": [
    "【limit_per_source】每日定时任务每个固定源（RSS）最多抓多少条，可选（默认 15）。",
    "修改方式：改数字；命令行 --limit 显式传参会优先于这里的值。",
    "不填会怎样：使用内置默认 15（push_to_obsidian 的兜底值）。"
  ],
  "search_query_optimization": false,
  "_search_query_optimization说明": [
    "【search_query_optimization】搜索词 LLM 消歧开关，可选（默认 false）。",
    "作用：开启后每个 topic 先经 LLM 拆成 1~3 个搜索变体再全搜合并，用于英文多义词（如 trellis）搜出错误义项的场景。",
    "代价：多一轮 LLM 调用。修改方式：true / false。",
    "不填会怎样：默认 false，不做消歧，多义词 topic 可能搜出错误义项。"
  ],
  "block_url_patterns": [
    "/docs/",
    "/tutorials/",
    "/blogs/how-to-become"
  ],
  "_block_url_patterns说明": [
    "【block_url_patterns】L0 零成本硬挡规则（URL 路径匹配），可选。",
    "作用：动态搜索结果中 URL path 命中这些片段的直接丢弃，不进 LLM 评估（省 token）。",
    "只作用于动态搜索项，RSS 固定源全部保留。",
    "修改方式：增删路径片段字符串；留空数组 [] 表示不挡。",
    "不填会怎样：不做路径硬挡，所有 URL 都进 LLM 评估（费 token，且可能收进 /docs/ /tutorials/ 类内容）。"
  ],
  "block_hosts": [
    "en.wikipedia.org",
    "aws.amazon.com",
    "learn.microsoft.com",
    "geeksforgeeks.org"
  ],
  "_block_hosts说明": [
    "【block_hosts】L0 零成本硬挡规则（域名匹配），可选。",
    "作用：动态搜索结果中 hostname 等于或属于这些域名的直接丢弃。",
    "注意：en.wikipedia.org 会挡本域及子域（blog.en.wikipedia.org），但 en.m.wikipedia.org 是 m.wikipedia.org 子域、与 en 平级不命中——要挡整站需加根域（如 wikipedia.org）。",
    "修改方式：增删域名；留空数组 [] 表示不挡。",
    "不填会怎样：不做域名硬挡，这些站的内容会进 LLM 评估（费 token，且常是低质内容）。"
  ]
}
