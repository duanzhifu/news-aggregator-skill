# ============================================================
# news-aggregator LLM 配置（.env 已被 gitignore，勿提交）
# 双 provider 切换：注释掉「当前激活」块、取消注释「备用」块
# （LLM_BASE_URL / LLM_API_KEY / LLM_MODEL / LLM_API_MODE 四行对调）
#
# 规则：
#   1. 永远只留一块 LLM_* 未注释（解析器 setdefault 只认先出现者，两块都开会静默用错模型）
#   2. 注释必须独占一行（解析器不剥行尾 #，行尾注释会读进值）
#   3. 切完手动确认 LLM_BASE_URL 指向目标端点
# ============================================================

# ============ 当前激活：商汤 SenseNova（deepseek-v4-pro）============
# 商汤不支持 /responses，LLM_API_MODE=auto 自动降级 /chat/completions
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_API_KEY=<在这里填入商汤真实 key,勿提交>
LLM_MODEL=deepseek-v4-pro
LLM_API_MODE=auto

# ============ 备用：timicc 中转（deepseek-v4-flash-vision-exp）============
# 切换 = 注释掉上面商汤块、取消注释下面 timicc 块（四行对调）
# LLM_BASE_URL=https://timicc.com/v1
# LLM_API_KEY=<在这里填入 timicc 真实 key，勿提交>
# LLM_MODEL=deepseek-v4-flash-vision-exp
# LLM_API_MODE=auto

# ============ Groq Whisper 转写（常开）============
GROQ_API_KEY=<在这里填入 Groq 真实 key,勿提交>

# ============ AnySearch 动态搜索（常开）============
# key 来源：https://anysearch.com/console/api-keys（as_sk_ 前缀）
ANYSEARCH_API_KEY=<在这里填入 AnySearch 真实 key,勿提交>
